), Intelligent Supply Chain", "uolDetail": "Final-year GPA 3.65/4.00 · Major GPA 3.51/4.00. Research developed across software compliance, AI-assisted engineering and spatiotemporal learning.", "researchKicker": "Research agenda", "researchTitle": "What I work on", "researchIntro": "I study how evidence, semantics and trustworthy automation can improve software systems throughout their lifecycle.", "researchOneTitle": "Software compliance & privacy", "researchOneText": "Benchmarks and analysis methods for detecting GDPR and policy violations in real-world software.", "keywordEvidence": "Evidence", "researchTwoTitle": "LLMs for software engineering", "researchTwoText": "Evaluation and design of language-model agents for analysis, repair and evidence-driven engineering workflows.", "keywordAgents": "Agents", "researchThreeTitle": "Program analysis & secure systems", "researchThreeText": "Static reasoning, abstract interpretation and runtime evidence for secure software, smart contracts and WebAssembly.", "keywordStatic": "Static analysis", "researchFourTitle": "Trustworthy AI & provenance", "researchFourText": "Accountability, provenance verification and reviewable evidence for AI-assisted software development.", "keywordAccountability": "Accountability", "keywordAudit": "Audit", "publicationsKicker": "Research output", "publicationsTitle": "Publications & preprints", "publicationsIntro": "Published papers, accepted posters, proceedings papers and public preprints. My name is highlighted in each author list.", "openScholar": "Open Google Scholar", "filterAll": "All", "filterJournal": "Journal", "filterConference": "Conference", "filterPoster": "Posters", "filterPreprint": "Preprints", "contributionKicker": "Research contribution", "contributionTitle": "Contribution beyond authorship", "contributionIntro": "Acknowledged research contributions are separated from authored publications.", "acknowledgedContributor": "Acknowledged contributor", "roundTwo": "Advanced to Roun